node_modules/
dist/
.env
# Anything holding a copy of .env. The `.env` rule above does NOT match these —
# `git check-ignore` confirms both were committable — and services/pin.js writes
# exactly these names when rotating the PIN. A stranded copy after a crash is
# one `git add -A` from publishing a live credential (#123).
.env.tmp-*
.env.bak*
neuro-env-backup-*
*.db
*.db-journal
*.db-wal
*.db-shm
backend/C:/
backend/C:/

# Local Netlify folder
.netlify

# Dev screenshots / scratch images at repo root
/pi-*.png

# Python caches & local backups
__pycache__/
*.pyc
*.bak-*

# Runtime logs & local-only dirs
sara/logs/
/Private

# Machine-local Claude Code overrides (keep memory/skills tracked)
.claude/settings.local.json

# One-off migration staging blob (patch + tarball)
/_incoming-daypilot-sara/

# Core dumps. `/proc/sys/kernel/core_pattern` is the bare string `core`, so a
# dump lands in the process's CWD — which for the backend is this working tree.
# A core is the backend's process MEMORY: the PIN, the API token, the OpenRouter
# key, live Graph tokens. This repo is PUBLIC and `git add -A` has swept files up
# here before, so an ignore rule is the belt to the pm2 unit's braces
# (`LimitCORE=0`, set 31 Aug 2026 after 63 dumps / 3.0 GB from one restart loop).
core
core.[0-9]*
