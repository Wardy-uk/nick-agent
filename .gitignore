node_modules/
dist/
.env
# Anything holding a copy of .env. The `.env` rule above does NOT match these —
# `git check-ignore` confirms both were committable — and services/pin.js writes
# exactly these names when rotating the PIN. A stranded copy after a crash is
# one `git add -A` from publishing a live credential (#123).
.env.tmp-*
.env.bak*
neuro-env-backup-*
*.db
*.db-journal
*.db-wal
*.db-shm
backend/C:/
backend/C:/

# Local Netlify folder
.netlify

# Dev screenshots / scratch images at repo root
/pi-*.png

# Python caches & local backups
__pycache__/
*.pyc
*.bak-*

# Runtime logs & local-only dirs
sara/logs/
/Private

# Machine-local Claude Code overrides (keep memory/skills tracked)
.claude/settings.local.json

# One-off migration staging blob (patch + tarball)
/_incoming-daypilot-sara/
