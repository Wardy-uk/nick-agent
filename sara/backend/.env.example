# SARA backend runtime config
# Copy to .env on the Pi 5. This file is gitignored — never commit a real credential.

# Port the SARA backend listens on. Default 3005 to avoid clashing with the
# existing NEURO backend on 3001.
SARA_PORT=3005

# ============================================================================
# NEURO connection — REQUIRED. SARA is a manifestation layer over NEURO; without
# this it can show nothing and save nothing, and it will say so loudly at startup
# and on GET /api/health rather than pretending.
# ============================================================================

# Where NEURO is. ⚠ There is NO DEFAULT, deliberately: this used to default to a
# public hostname, so an unconfigured SARA silently reached a remote host over the
# open internet while looking correctly configured.
NEURO_BASE_URL=http://127.0.0.1:3001

# ONE of the two below is required.
#
# NEURO_API_TOKEN is preferred — SARA is a machine client, and NEURO issues this
# credential for exactly that (X-NEURO-API-TOKEN). When both are set, the token wins.
# NEURO_API_TOKEN=
#
# NEURO_PIN is the human credential (X-NEURO-PIN). It can also be supplied at runtime
# from the Settings screen, which is why an unconfigured SARA must still boot.
# NEURO_PIN=

# Chat/nudge transport paths on NEURO. Rarely need changing.
# NEURO_CHAT_PATH=/api/chat
# NEURO_NUDGES_PATH=/api/nudges/stream

# Snapshot poller. A failed poll keeps the last good payload for up to 15 minutes,
# marked `stale` with its age, then degrades to `unavailable`.
# SARA_NEURO_POLL_MS=30000
# SARA_NEURO_TIMEOUT_MS=5000

# --- Demo mode -------------------------------------------------------------
# ⚠ NEVER set this in production. `true` lets the hardcoded content in
# src/state/seed.js reach the screens — invented tickets, an invented probation
# review, and an invented performance concern about a named colleague. Every domain
# is stamped `demo` and the UI banner shouts DEMO, and it is refused outright when
# NODE_ENV=production, but the only safe setting here is unset.
# SARA_DEMO_MODE=false

# --- Home Assistant telemetry bridge (WS3-WP1) ---
# All optional. If unset, the telemetry bridge stays idle and SARA falls back honestly
# (location comes from seed, /api/state reports telemetry.available=false). HA is a
# telemetry BUS only — these signals feed the shared state model, they do not drive
# decisions or view selection.
#
# Base URL of your Home Assistant instance (no trailing slash) and a long-lived access
# token (HA profile -> Long-Lived Access Tokens). Both are required to go live.
# SARA_HA_BASE_URL=http://homeassistant.local:8123
# SARA_HA_TOKEN=

# Bounded v0 signal scope: exactly three slots, each naming ONE HA entity to read.
# Set the ones you have; missing slots are reported as a "partial" telemetry snapshot.
#   location    — a person/device_tracker entity (state is a zone: home / not_home / <zone>)
#   presence    — a binary_sensor or person entity (on/off/home/away -> present true/false)
#   environment — any sensor (e.g. temperature) — one signal to prove the seam
# SARA_HA_LOCATION_ENTITY=person.nick
# SARA_HA_PRESENCE_ENTITY=binary_sensor.office_occupancy
# SARA_HA_ENV_ENTITY=sensor.office_temperature

# Poll interval and per-request timeout (ms). Defaults: 30000 / 4000.
# SARA_HA_POLL_MS=30000
# SARA_HA_TIMEOUT_MS=4000
